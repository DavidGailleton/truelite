# Copy to .env for local development. Never commit .env.
TRUELITE_LISTEN=127.0.0.1:8080
RUST_LOG=info,truelite=debug

# The NAS. wss:// needs the SHA-256 fingerprint of the NAS certificate: truelite trusts exactly
# that certificate (no CA, host name or expiry check). Get it with:
#   openssl s_client -connect truenas.local:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# Plain ws:// is only accepted to localhost (development).
# TRUELITE_NAS_URL=wss://truenas.local
# TRUELITE_NAS_FINGERPRINT=AB:CD:...

# Sessions: one ends after this many minutes with no request and no open tab (default 30),
# and in any case this many hours after login (default 24).
# TRUELITE_SESSION_IDLE_MINUTES=30
# TRUELITE_SESSION_MAX_HOURS=24

# /ws and the login/logout POSTs only accept the page's own origin (the Origin header must
# match the Host the request was sent to), so any address of the server works over plain HTTP.
# If a reverse proxy rewrites Host, list the public
# origins here, comma-separated, e.g. https://nas.example.org. HTTPS and HSTS are the proxy's job.
# TRUELITE_ALLOWED_ORIGINS=https://nas.example.org
